# Copy this file to .env and adjust if needed. .env is gitignored —
# it's where real local secrets/config live; .env.example just documents
# the shape so a stranger cloning the repo knows what to fill in.

# --- Postgres (used by both docker-compose.yml and the app) ---
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=taskapi
POSTGRES_DB=tasks

# Host-side port Postgres is published on (container always listens on 5432
# internally). Defaulted away from 5432 in case something else on your
# machine already uses it.
POSTGRES_PORT=5433

# Full connection string the app uses to reach Postgres.
# When running the app via `docker compose up`, the app container talks to
# Postgres over the internal Docker network, so the host is the service
# name "db", not localhost:
DATABASE_URL=postgresql://taskapi:taskapi@db:5432/tasks

# When running the app locally with `uvicorn` (outside Docker) against the
# same Postgres container, use localhost and the published port instead:
# DATABASE_URL=postgresql://taskapi:taskapi@localhost:5433/tasks

# --- Storage backend selector ---
# "postgres" -> use Postgres (requires DATABASE_URL above)
# "sqlite"   -> use the local tasks.db file (Week 3 behavior, no Docker needed)
DB_BACKEND=postgres
